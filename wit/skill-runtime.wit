package skill-forge:runtime;

interface types {
  record skill-error {
    code: error-code,
    message: string,
    stack: option<string>,
  }

  enum error-code {
    type-error,
    runtime-error,
    capability-denied,
    network-error,
    fs-error,
    user-error,
  }
}

interface skill-loader-host {
  get-source: func() -> string;
}

interface llm-host {
  call-llm: func(prompt: string, input-json: string) -> result<string, string>;
}

interface exec-host {
  exec-cmd: func(cmd: string, args: list<string>) -> result<string, string>;
}

world skill-runtime {
  use types.{skill-error};

  import skill-loader-host;
  import llm-host;
  import exec-host;

  export run: func(args-json: string) -> result<string, skill-error>;
}
