package skill-forge:runtime;

interface types {
  record skill-error {
    code: error-code,
    message: string,
    stack: option<string>,
  }

  enum error-code {
    type-error,
    runtime-error,
    capability-denied,
    network-error,
    fs-error,
    user-error,
    depth-exceeded,
    timeout,
  }
}

interface skill-loader-host {
  get-source: func() -> string;
  get-description: func(skill-name: string) -> string;
}

interface schema-loader-host {
  get-schema-source: func() -> string;
  get-input-schema-json: func(skill-name: string) -> string;
}

interface llm-host {
  call-llm: func(prompt: string, input-json: string) -> result<string, string>;
}

interface exec-host {
  exec-cmd: func(cmd: string, args: list<string>) -> result<string, string>;
}

interface anthropic-host {
  messages: func(body-json: string) -> result<string, string>;
}

interface invoke-host {
  use types.{skill-error};
  invoke: func(skill-name: string, args-json: string) -> result<string, skill-error>;
}

world skill-runtime {
  use types.{skill-error};

  import skill-loader-host;
  import schema-loader-host;
  import llm-host;
  import exec-host;
  import anthropic-host;
  import invoke-host;

  export run: func(args-json: string) -> result<string, skill-error>;
  export get-schema: func() -> result<string, skill-error>;
}
